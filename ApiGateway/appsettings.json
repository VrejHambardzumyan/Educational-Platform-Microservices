{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "PublicKeyPath": "C:\\Users\\ideat\\Documents\\public_key.pem",
    "Issuer": "AuthService"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "user-management",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "user-management",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "courses-route": {
        "ClusterId": "course-catalog",
        "Match": { "Path": "/CourseCatalog/{**catch-all}" }
      },
      "enrollment-route": {
        "ClusterId": "course-enrollment",
        "Match": { "Path": "/CourseEnrollment/{**catch-all}" }
      },
      "progress-route": {
        "ClusterId": "progress-tracking",
        "Match": { "Path": "/progress/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-management": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5023" }
        }
      },
      "course-catalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5034" }
        }
      },
      "course-enrollment": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5220" }
        }
      },
      "progress-tracking": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5046" }
        }
      }
    }
  }
}
